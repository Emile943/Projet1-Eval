# {{ ansible_managed }}

server {
    listen {{ nginx_listen_port }};
    server_name _;

    # Racine de l'application 
    root /opt/fleetinfo/current;
    index index.html;

    # Page d'accueil de l'application
    location / {
        try_files $uri $uri/ =404;
    }

    # Endpoint de contrôle de santé
    location = /health {
        default_type application/json;
        try_files /health.json =404;
    }

    # Page technique protégée par mdp
    location = /status {
        stub_status;
        auth_basic "Acces Protege - Administration";
        auth_basic_user_file /etc/nginx/.htpasswd;
    }
}